{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "storaged-frontend",
  "routes": [
    { "pattern": "storaged.sarthaksahu.dev", "custom_domain": true }
  ],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://storaged-api.sarthaksahu.dev/api"
  }
}
