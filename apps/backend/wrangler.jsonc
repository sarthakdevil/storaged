{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "storaged-api",
  "main": "src/edge.ts",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "FRONTEND_ORIGIN": "https://storaged-frontend.vercel.app",
    "FRONTEND_ORIGINS": "https://storaged.sarthaksahu.dev,https://storaged-frontend.sarthhttpsdynamiclegendhomeblog20200922gamakrajesh2005.workers.dev",
  },

  "hyperdrive": [
    { "binding": "HYPERDRIVE", "id": "43c306f298254cc6b475dbb8e14ae869" }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  }

  // Add these bindings after creating Cloudflare resources:
  //
  // "r2_buckets": [
  //   { "binding": "STORAGE_BUCKET", "bucket_name": "storaged-files" }
  // ],
  //
  // Durable upload finalization (replaces the old pg-boss worker).
  // Until configured, finalization runs inline via ctx.waitUntil() — see edge.ts.
  // To enable durable retries (Workers Paid), first run:
  //   wrangler queues create storaged-upload-finalize
  //   wrangler queues create storaged-upload-finalize-dlq
  // then uncomment:
  //
  // "queues": {
  //   "producers": [
  //     { "binding": "UPLOAD_QUEUE", "queue": "storaged-upload-finalize" }
  //   ],
  //   "consumers": [
  //     {
  //       "queue": "storaged-upload-finalize",
  //       "max_retries": 5,
  //       "max_batch_size": 10,
  //       "dead_letter_queue": "storaged-upload-finalize-dlq"
  //     }
  //   ]
  // }
}
