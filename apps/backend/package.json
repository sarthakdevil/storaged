{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate && wrangler dev --port 8787",
    "prisma:generate": "prisma generate --config ../../packages/db/prisma.config.ts && node ../../packages/db/scripts/patch-prisma-runtime.mjs",
    "build:cloudflare": "npm run prisma:generate && wrangler deploy --dry-run",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts",
    "deploy:cloudflare": "npm run prisma:generate && wrangler deploy",
    "prisma:migrate:deploy": "prisma migrate deploy --config ../../packages/db/prisma.config.ts",
    "preview:cloudflare": "wrangler dev --local --port 8787",
    "lint": "eslint src/",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@repo/auth": "*",
    "@repo/db": "*",
    "@repo/types": "*",
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/lib-storage": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^16.0.3",
    "pg": "^8.20.0",
    "resend": "^6.12.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260627.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.0",
    "prisma": "^7.8.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
