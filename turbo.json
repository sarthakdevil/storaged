{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "build:cloudflare": {
      "dependsOn": ["^build:cloudflare"],
      "inputs": ["$TURBO_DEFAULT$", ".env*", "wrangler.jsonc"],
      "outputs": [".open-next/**", ".wrangler/**"]
    },
    "deploy:cloudflare": {
      "dependsOn": ["build:cloudflare"],
      "cache": false
    },
    "preview:cloudflare": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
