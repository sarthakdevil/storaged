{
  "name": "storaged",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:cloudflare": "turbo run build:cloudflare",
    "dev": "turbo run dev",
    "deploy:cloudflare": "turbo run deploy:cloudflare",
    "lint": "turbo run lint",
    "preview:cloudflare": "turbo run preview:cloudflare",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "prisma": {
    "schema": "apps/backend/prisma/schema.prisma"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/morgan": "^1.9.10",
    "prettier": "^3.7.4",
    "turbo": "^2.9.6",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "cors": "^2.8.6",
    "morgan": "^1.10.1"
  }
}
