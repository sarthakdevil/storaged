// ─────────────────────────────────────────────────────────────────────────────
// Canonical Prisma schema for the Storaged monorepo.
// All apps (apps/backend, ai/) point their prisma.config.ts here.
//
// Generator blocks:
//   backend-client → PostgreSQL (PrismaPg, workerd runtime) for apps/backend
//   ai-client      → D1 SQLite  (PrismaD1, workerd runtime) for ai/
// ─────────────────────────────────────────────────────────────────────────────

generator backend_client {
  provider     = "prisma-client"
  output       = "../../../apps/backend/src/generated/prisma"
  runtime      = "workerd"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  ADMIN
}

enum NodeType {
  FOLDER
  FILE
}

enum UploadSessionStatus {
  INITIATED
  UPLOADING
  COMPLETING
  COMPLETED
  FAILED
  ABORTED
}

// ─── Auth ─────────────────────────────────────────────────────────────────────

model User {
  id                  String               @id @default(uuid())
  email               String               @unique
  name                String?
  password            String
  role                UserRole             @default(USER)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  drives              Drive[]
  createdNodes        Node[]               @relation("NodeCreatedBy")
  deletedNodes        Node[]               @relation("NodeDeletedBy")
  shareLinks          ShareLink[]
  apiKeys             ApiKey[]
  uploadSessions      UploadSession[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?
  userAgent String?
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

// ─── File system ──────────────────────────────────────────────────────────────

model Drive {
  id             String          @id @default(uuid())
  ownerId        String
  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String
  usedBytes      BigInt          @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  nodes          Node[]
  uploadSessions UploadSession[]

  @@unique([ownerId, name])
}

model Node {
  id          String    @id @default(uuid())
  driveId     String
  drive       Drive     @relation(fields: [driveId], references: [id], onDelete: Cascade)
  parentId    String?
  // Cascade lets deleting a folder remove its entire subtree automatically
  parent      Node?     @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  children    Node[]    @relation("NodeTree")
  type        NodeType
  name        String
  path        String
  description String?
  sizeBytes   BigInt    @default(0)
  mimeType    String?
  isFavorite  Boolean   @default(false)

  // ── Recycle bin ─────────────────────────────────────────────────────────────
  // When a node is trashed:
  //   • isDeleted is set to true
  //   • path is rewritten to /__trash__/<id>[/...] so the original path is freed
  //   • originalPath / originalName are saved for restore
  //   • parentId is preserved so the subtree hierarchy survives in trash
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  deletedById  String?
  deletedBy    User?     @relation("NodeDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  originalPath String?
  originalName String?

  createdById String?
  createdBy   User?        @relation("NodeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  fileObjects FileObject[]
  tags        NodeTag[]
  shareLinks  ShareLink[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([driveId, path])
  @@index([driveId, parentId])
  @@index([driveId, type])
  @@index([driveId, isDeleted, deletedAt])
  @@index([driveId, isFavorite])
}

// ─── Tagging ──────────────────────────────────────────────────────────────────

model Tag {
  id        String    @id @default(uuid())
  name      String    @unique
  color     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  nodes     NodeTag[]
}

model NodeTag {
  nodeId    String
  tagId     String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([nodeId, tagId])
  @@index([tagId])
}

// ─── Storage buckets ──────────────────────────────────────────────────────────

model Bucket {
  id             String          @id @default(uuid())
  providerName   String
  displayName    String?
  bucketName     String
  config         Json
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  fileObjects    FileObject[]
  uploadSessions UploadSession[]

  @@unique([providerName, bucketName])
}

model FileObject {
  id        String   @id @default(uuid())
  nodeId    String
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  bucketId  String
  bucket    Bucket   @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  objectKey String
  checksum  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bucketId, objectKey])
  @@index([nodeId])
  @@index([bucketId])
}

// ─── API keys ─────────────────────────────────────────────────────────────────

model ApiKey {
  id         String    @id @default(uuid())
  name       String
  keyHash    String    @unique
  prefix     String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([keyHash])
}

// ─── Share links ──────────────────────────────────────────────────────────────

model ShareLink {
  id          String    @id @default(uuid())
  token       String    @unique @default(uuid())
  nodeId      String
  node        Node      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([nodeId])
  @@index([token])
}

// ─── Multipart/resumable uploads ─────────────────────────────────────────────

model UploadSession {
  id           String              @id @default(uuid())
  status       UploadSessionStatus @default(INITIATED)

  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  driveId      String
  drive        Drive               @relation(fields: [driveId], references: [id], onDelete: Cascade)

  parentId     String?

  fileName     String
  mimeType     String?
  sizeBytes    BigInt
  partSizeBytes Int

  bucketId     String
  bucket       Bucket              @relation(fields: [bucketId], references: [id], onDelete: Cascade)
  objectKey    String
  uploadId     String

  // Stored when client requests completion; worker uses this payload.
  // Expected shape: [{ partNumber: number, etag: string }]
  completedParts Json?

  nodeId       String?

  errorMessage String?
  completedAt  DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId, status])
  @@index([driveId])
  @@index([bucketId, objectKey])
}
