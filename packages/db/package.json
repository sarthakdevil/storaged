{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./pg-client": "./src/pg-client.ts",
    "./d1-client": "./src/d1-client.ts",
    "./prisma/schema.prisma": "./prisma/schema.prisma"
  },
  "scripts": {
