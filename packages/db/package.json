    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@cloudflare/workers-types": "^4.20260627.0",
    "@types/node": "^22.10.0",
    "@prisma/adapter-d1": "^7.8.0",
    "dotenv": "^16.0.3",
    "prisma": "^7.8.0",
    "typescript": "5.9.2"
  }
}
